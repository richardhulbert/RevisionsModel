{
    "name": "richardhulbert/revisions-model",
    "description": "Append-only, branch-aware revision models for Laravel Eloquent. Records are never updated in place - every change is a new row, so history is permanent and any revision can be rolled back.",
    "keywords": ["laravel", "eloquent", "revisions", "versioning", "branches", "audit"],
    "license": "MIT",
    "authors": [
        {
            "name": "Richard Hulbert",
            "email": "richard@richardhulbert.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "RichardHulbert\\Revisions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RichardHulbert\\Revisions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RichardHulbert\\Revisions\\RevisionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
